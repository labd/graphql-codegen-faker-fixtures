{
	"name": "graphql-codegen-faker-fixtures",
	"description": "Generate faker fixtures for your fields",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"version": "0.8.1",
	"license": "MIT",
	"keywords": [
		"graphql",
		"codegen",
		"graphql-codegen",
		"plugin",
		"typescript",
		"mocks",
		"fakes"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"type": "commonjs",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "tsdown",
		"example:ts": "graphql-codegen --config example/codegen.ts",
		"example:yml": "graphql-codegen --config example/codegen.yml",
		"format": "biome check --linter-enabled=false",
		"format:fix": "biome check --linter-enabled=false --write",
		"lint": "biome lint --max-diagnostics 500",
		"lint:fix": "biome lint --max-diagnostics 500 --fix",
		"lint:knip": "pnpm knip",
		"prepare": "husky",
		"start": "tsdown --watch",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"check": "biome ci && pnpm build && pnpm typecheck",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"publish:version": "pnpm changeset version && pnpm format:fix"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/plugin-helpers": "^7.4.2",
		"deepmerge-ts": "8.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.5",
		"graphql": "^17.0.2",
		"graphql-tag": "^2.12.7",
		"husky": "^9.1.7",
		"knip": "^6.42.0",
		"lint-staged": "^17.6.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@graphql-codegen/cli": "^7.0.0",
		"@graphql-codegen/plugin-helpers": "^7.0.0",
		"graphql": "^16.0.0 || ^17.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/graphql-codegen-faker-fixtures.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
